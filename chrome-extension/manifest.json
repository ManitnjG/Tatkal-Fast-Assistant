{
  "manifest_version": 3,
  "name": "Tatkal Fast Assistant — AI",
  "version": "0.1.0",
  "minimum_chrome_version": "112",
  "description": "AI journey preparation and reviewed autofill on official IRCTC. CAPTCHA, OTP and payment stay manual.",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "action": {"default_popup": "popup.html", "default_title": "Tatkal AI Assistant"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src https://generativelanguage.googleapis.com"}
}
